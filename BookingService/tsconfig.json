{
  // File Inclusion
  "include": ["src/**/*", "prisma/**/*"],
  "exclude": ["node_modules"],

  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    "rootDir": ".",
    "outDir": "./dist",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,


    // Environment Settings
    "module": "ESNext",
    "target": "ES2023",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["node"],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,


    // Stricter Typechecking Options
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    "noUnusedLocals": true,
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,

    // Module Behavior
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "esModuleInterop": true,

    // Misc
    "skipLibCheck": true,

    // Workaround: redlock v5 beta has a broken exports map that omits the
    // "types" condition, so TypeScript cannot resolve types via moduleResolution.
    // This path override points directly to the .d.ts file.
    "paths": {
      "redlock": ["./node_modules/redlock/dist/index.d.ts"]
    }
  }
}
